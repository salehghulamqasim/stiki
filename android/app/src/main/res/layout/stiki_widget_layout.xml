<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Flutter-rendered image widget (for styled/colored backgrounds) -->
    <ImageView
        android:id="@+id/note_screenshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone" />

    <!-- Background Shape (supports tinting) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY"
        android:visibility="visible" />

    <!-- Text Container (Transparent) moved in front -->
    <LinearLayout
        android:id="@+id/native_text_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Tap to setup"
            android:textColor="#221A16"
            android:fontFamily="sans-serif-medium"
            android:maxLines="6"
            android:ellipsize="end"
            android:textSize="22sp" />

    </LinearLayout>

    <!-- Legacy default text (for backward compatibility) -->
    <TextView
        android:id="@+id/widget_default_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Tap to Setup"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:visibility="gone" />

</FrameLayout>